{
  "name": "safedoc-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.ts",
    "verify:product": "npm test && tsc --noEmit && eslint",
    "package:product": "npm run build && tsx scripts/package-release.ts",
    "release:product": "npm run verify:product && npm run package:product",
    "receipt:release": "tsx scripts/local-release-receipt.ts create",
    "readiness:release-receipt": "tsx scripts/local-release-receipt.ts check",
    "readiness:product": "tsx scripts/check-product-readiness.ts",
    "readiness:control-plane": "tsx scripts/check-production-control-plane-readiness.ts",
    "readiness:promotion-evidence": "tsx scripts/check-promotion-evidence.ts",
    "readiness:promotion-context": "tsx scripts/check-promotion-evidence.ts --print-context",
    "readiness:remediation-approval": "tsx scripts/build-production-remediation-approval-packet.ts",
    "readiness:remediation-preflight": "tsx scripts/build-production-remediation-execution-preflight.ts",
    "harness:instructions": "tsx scripts/check-agent-instructions.ts",
    "harness:landing-goal": "tsx scripts/check-landing-goal-harness.ts",
    "harness:en-balance": "tsx scripts/check-en-landing-balance.ts",
    "harness:en-balance:pixels": "tsx scripts/check-en-landing-pixel-balance.ts",
    "lifecycle:status": "tsx scripts/lifecycle-harness.ts status",
    "lifecycle:validate": "tsx scripts/lifecycle-harness.ts validate",
    "lifecycle:start": "tsx scripts/lifecycle-harness.ts start",
    "lifecycle:complete": "tsx scripts/lifecycle-harness.ts complete",
    "growth:audit": "node scripts/growth/audit-en-funnel.js && node scripts/growth/audit-brand-consistency.js",
    "growth:live-contract": "node scripts/growth/audit-live-product-contract.js",
    "growth:payments": "node scripts/growth/audit-polar-health.js",
    "growth:payments:sync-descriptions": "node scripts/growth/sync-polar-product-descriptions.js",
    "growth:payments:dummy": "node scripts/growth/test-polar-webhook-dummy.js",
    "growth:cases": "node scripts/growth/extract-case-study-candidates.js",
    "growth:seo": "node scripts/growth/generate-seo-briefs.js",
    "growth:weekly": "node scripts/growth/generate-weekly-growth-report.js",
    "growth:shorts": "node scripts/growth/generate-shorts-script.js",
    "growth:leads": "node scripts/growth/score-outreach-leads.js",
    "growth:replies": "node scripts/growth/handle-outreach-replies.js",
    "growth:replies:draft": "node scripts/growth/handle-outreach-replies.js --create-drafts",
    "growth:outreach:preflight": "node scripts/growth/preflight-outreach.js",
    "growth:buyers": "node scripts/growth/report-buyer-activity.js",
    "growth:ops:sync": "node scripts/growth/sync-daily-ops-log.js",
    "growth:schedule": "node scripts/growth/print-automation-schedule.js",
    "growth:today": "node scripts/growth/run-scheduled-growth.js",
    "growth:daily": "node scripts/growth/run-daily-growth.js",
    "growth:env": "node scripts/growth/check-growth-env.js",
    "growth:acquisition:gate": "node scripts/growth/check-acquisition-readiness.js",
    "growth:social:dry-run": "node scripts/growth/run-social-dry-run.js",
    "growth:linkedin": "node scripts/growth/linkedin-launch.js",
    "growth:linkedin:dry-run": "node scripts/growth/linkedin-launch.js --dry-run",
    "growth:buffer:channels": "node scripts/growth/list-buffer-channels.js",
    "growth:buffer:audit": "node scripts/growth/audit-buffer-launch.js",
    "growth:reddit": "node scripts/growth/reddit-launch.js",
    "growth:reddit:dry-run": "node scripts/growth/reddit-launch.js --dry-run",
    "sessions": "node scripts/export-session.mjs",
    "sessions:list": "node scripts/export-session.mjs --list",
    "sessions:all": "node scripts/export-session.mjs --all",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:adopt": "tsx --env-file=.env.local scripts/adopt-baseline.ts",
    "db:ingest:opendart": "node --env-file=.env.local --import tsx scripts/ingest-opendart.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@auth/drizzle-adapter": "1.11.3",
    "@google/generative-ai": "^0.24.1",
    "@neondatabase/serverless": "^1.1.0",
    "@next/env": "16.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tosspayments/payment-sdk": "^1.9.2",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "dompurify": "3.4.13",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "next": "16.3.0",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.2",
    "sanitize-html": "^2.17.5",
    "undici": "7.29.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "pg": "^8.23.0",
    "puppeteer": "^25.0.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
